# Copy to .env and fill values. Never commit .env.

COMPANY_NAME=2os Gestion

# Required in production (DJANGO_DEBUG=0). Optional in local DEBUG.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# 1 = development, 0 = production
DJANGO_DEBUG=1

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated HTTPS origins for CSRF (production)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://votre-domaine.com

# --- Database ---
# Local DX (default): SQLite when USE_POSTGRES / DJANGO_DB_ENGINE unset
# DJANGO_SQLITE_PATH=db.sqlite3

# Docker Compose sets these automatically for the web service.
# Uncomment for local Postgres:
# USE_POSTGRES=1
# DJANGO_DB_ENGINE=postgres
# DB_NAME=2osgestion
# DB_USER=2osgestion
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
# DATABASE_URL=postgres://2osgestion:change-me@localhost:5432/2osgestion

# Entrypoint
RUN_MIGRATIONS=1

# Upload limits (bytes) — default 25 MiB
# DJANGO_MAX_UPLOAD_SIZE=26214400
# DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=26214400
# DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=26214400

# Production behind HTTPS reverse proxy:
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_BEHIND_PROXY=1

# --- Email (password mail on user create) ---
# Local Mailpit: docker compose up -d mailpit — UI http://127.0.0.1:8025
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=False
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@2osgestion.local
# Gmail (App Password, not normal password):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False
# DEFAULT_FROM_EMAIL=your@gmail.com


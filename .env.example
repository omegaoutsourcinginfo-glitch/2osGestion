# Copy to .env and fill values. Never commit .env.

# Required in production (DJANGO_DEBUG=0). Optional in local DEBUG.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# 1 = development, 0 = production
DJANGO_DEBUG=1

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated HTTPS origins for CSRF (production)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://votre-domaine.com

# Optional: custom sqlite path (Docker uses /app/data/db.sqlite3)
# DJANGO_SQLITE_PATH=db.sqlite3

# PostgreSQL (optional — leave unset to keep SQLite)
# DATABASE_URL=postgres://2osgestion:change-me@localhost:5432/2osgestion
# or:
# DJANGO_DB_ENGINE=postgres
# POSTGRES_DB=2osgestion
# POSTGRES_USER=2osgestion
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Upload limits (bytes) — default 25 MiB
# DJANGO_MAX_UPLOAD_SIZE=26214400
# DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=26214400
# DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=26214400

# Production behind HTTPS reverse proxy:
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_BEHIND_PROXY=1

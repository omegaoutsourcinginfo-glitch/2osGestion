{
  "name": "2osgestion",
  "version": "0.1.0",
  "private": true,
  "description": "2os Gestion — Tailwind CSS build (npm)",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./frontend/src/input.css -o ./frontend/dist/app.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./frontend/src/input.css -o ./frontend/dist/app.css --watch",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "tailwindcss": "^4.1.14"
  }
}

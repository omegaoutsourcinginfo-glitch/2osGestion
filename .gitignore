# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.*
!.env.example

# Django / local data (never commit secrets or live DB/uploads)
db.sqlite3
*.sqlite3
data/
media/
staticfiles/
*.log
local_settings.py

# Node / frontend build
node_modules/
# Keep frontend/dist/app.css committed so Docker/prod works without npm.
# Ignore other generated artifacts under dist if added later.
frontend/dist/*
!frontend/dist/.gitkeep
!frontend/dist/app.css

# IDE / OS
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store
